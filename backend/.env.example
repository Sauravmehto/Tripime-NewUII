# Copy to .env for local use. On Render, set these in the dashboard (do not commit .env).

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_JWT_SECRET=change-this-to-a-long-random-string
# Signs customer sessions. MUST differ from ADMIN_JWT_SECRET.
CUSTOMER_JWT_SECRET=change-this-to-a-different-long-random-string
ADMIN_TOKEN_TTL_HOURS=12
# Admin session = HttpOnly cookie + CSRF header. Return the raw JWT in the login response too?
# Only for scripts/smoke tests; defaults to true in development and false in production.
# ADMIN_RETURN_TOKEN=true
# Admin login brute-force protection (per client IP and per username; locks double up to the max).
# ADMIN_LOGIN_IP_MAX_FAILURES=5
# ADMIN_LOGIN_ACCOUNT_MAX_FAILURES=20
# ADMIN_LOGIN_WINDOW_SECONDS=900
# ADMIN_LOGIN_LOCK_BASE_SECONDS=60
# ADMIN_LOGIN_LOCK_MAX_SECONDS=900
# Share lockout counters between instances (needed if you run more than one). Empty = in-process.
# REDIS_URL=redis://...
# Proxies in front of the app whose X-Forwarded-For we trust. Default 1 on Render, else 0.
# Too high lets clients forge their IP; too low makes everyone look like the proxy.
# TRUSTED_PROXY_HOPS=1

# Optional email (booking still works if blank — logs "SMTP is not configured")
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Production: exact Netlify origin(s), comma-separated.
# *.netlify.app is also allowed by default CORS_ORIGIN_REGEX in config.py.
CORS_ORIGINS=https://your-site.netlify.app

# Optional WhatsApp alert to the Tripime team for every new enquiry (free, via CallMeBot).
# One-time setup: from the phone below, send "I allow callmebot to send me messages"
# to CallMeBot's WhatsApp number (see https://www.callmebot.com/blog/free-api-whatsapp-messages/),
# then paste the API key it replies with. Leave blank to turn alerts off.
WHATSAPP_ALERT_PHONE=919899644177
WHATSAPP_CALLMEBOT_APIKEY=
# Or the official WhatsApp Business Cloud API (Meta). Needs an approved template whose
# body is a single {{1}} variable. Set WHATSAPP_PROVIDER=cloud_api to use it.
WHATSAPP_PROVIDER=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_TEMPLATE=
WHATSAPP_CLOUD_TEMPLATE_LANG=en

# "production" disables development-only behaviour (e.g. sign-in codes in the log).
APP_ENV=development
# In production (APP_ENV=production, or on Render) the app REFUSES TO START unless:
#   ADMIN_PASSWORD is 12+ chars and not a default/example value, and
#   ADMIN_JWT_SECRET and CUSTOMER_JWT_SECRET are each 32+ random chars and different.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"

# Booking-request notifications (email). Travellers also get an acknowledgement.
# Any SMTP provider works (Gmail, Brevo, SES, Postmark, SendGrid SMTP...). Gmail example:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USERNAME=tripimetrips@gmail.com
#   SMTP_PASSWORD=<16-char Google app password>
EMAIL_FROM=
BOOKING_NOTIFICATION_EMAIL=tripimetrips@gmail.com

# Booking alerts via WhatsApp only work with a provider above (CallMeBot / Cloud API).
# Travellers always get a click-to-chat link to this number that they send themselves.
BOOKING_WHATSAPP_NUMBER=919899640449

# Customer sign-in (email one-time code). Session is an HttpOnly cookie.
# Keep "lax" when the frontend proxies /api (same site). Use "none" (HTTPS only) if the
# browser calls the API on another site, e.g. Netlify -> Render without a proxy.
COOKIE_SAMESITE=lax
CUSTOMER_SESSION_HOURS=12
# Development only, never production: print sign-in codes to the log when SMTP isn't set.
CUSTOMER_OTP_DEV_LOG=true
# Development only: fixed sign-in code for ANY email while email isn't set up. Ignored when
# APP_ENV=production or SMTP is configured. Leave empty to turn off.
CUSTOMER_OTP_DEV_CODE=123456

# Payments: no gateway is integrated. Booking requests are paid offline after the team
# confirms; admins record verified payments. Confirm this UPI ID is correct and active.
PAYMENT_UPI_ID=tripimetrips@test.upi

# Mock flight inventory window (days from today, IST)
FLIGHT_BOOKING_WINDOW_DAYS=90
