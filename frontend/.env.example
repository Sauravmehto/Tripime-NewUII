# -----------------------------------------------------------------------------
# Local: leave EMPTY — Next rewrites /api → http://127.0.0.1:8002
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=

# -----------------------------------------------------------------------------
# Google Tag Manager (public container ID — safe in the browser)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GTM_ID=GTM-P5FT89CL

# -----------------------------------------------------------------------------
# Netlify (Site settings → Environment variables) — REQUIRED for production
# Use your Render service URL, NO trailing slash:
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_API_BASE_URL=https://tripime-new.onrender.com
# NEXT_PUBLIC_GTM_ID=GTM-P5FT89CL

# Admin login credentials are ONLY on the backend (Render), not in Next.js.
